PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fintrack
JWT_SECRET=your_jwt_secret_key_here

# Postmark Email Configuration
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
POSTMARK_FROM=your_sender_signature_email@domain.com

# Resend API Key (Recommended for cloud email delivery on Render)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=FinTrack <onboarding@resend.dev>

# Nodemailer Email Configuration (Fallback - Gmail or SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
